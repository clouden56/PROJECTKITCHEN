# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# Required for recipe suggestions: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# SECRET_KEY=any-long-random-string     # keeps flash messages valid across restarts
# PORT=5000
# HOST=127.0.0.1                        # the Docker image sets 0.0.0.0
# DATA_DIR=data
# GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash-lite
